{
  "name": "venomous-ui",
  "version": "0.1.0",
  "description": "Styled React component library with light/dark themes and SSR support.",
  "author": "BlaxBerry333",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/*": {
      "types": "./dist/react/*/index.d.ts",
      "import": "./dist/react/*/index.js"
    },
    "./styles/reset.css": "./dist/styles/reset.css",
    "./styles/themes/*.css": "./dist/styles/themes/*.css",
    "./styles/classnames/*.css": "./dist/styles/classnames/*.css",
    "./styles/components/*.css": "./dist/styles/components/*.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}