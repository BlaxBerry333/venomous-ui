{
  "extends": "./configs/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@utils/*": ["./packages/utils/*"],
      "@react/*": ["./packages/react/*"],
      "@vue/*": ["./packages/vue/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "configs/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".storybook/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
