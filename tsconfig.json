{
  "extends": "./configs/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@packages/*": ["./packages/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "configs/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".storybook/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
