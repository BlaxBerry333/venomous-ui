{
  "extends": "./configs/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@packages/*": ["./packages/*"],
      "@internal/*": ["./internal/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "internal/**/*.ts",
    "internal/**/*.tsx",
    "configs/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".storybook/**/*.d.ts",
    "types/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
